{
  "name": "novamerx-comms-worker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": "24.13.1",
    "pnpm": ">=10.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.migrate.json",
    "test": "vitest run",
    "build:migrate": "tsc -p tsconfig.migrate.json",
    "migrate": "tsx src/migrate/migrate.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir=dist",
    "conformance": "tsx scripts/conformance.ts"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "postal-mime": "^2.4.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "wrangler": "^3.107.0"
  }
}
