# The migration runner only. The Worker reads none of this — it runs at the edge and holds
# no connection string. See .dev.vars.example for the Worker's own configuration.

# The shared BuildFlow database. Same instance the parent platform owns.
DATABASE_URL=postgresql://buildflow:buildflow@localhost:5433/buildflow

# The schema this repository owns. A bare SQL identifier: it is interpolated into
# CREATE SCHEMA and into the ledger table name.
COMMS_SCHEMA=comms

# The role that READS AND WRITES these tables — TPS's database user. Optional, and unset on
# a single-role deployment, where the GRANT block in 001 is skipped entirely. Set it the day
# roles are split, not before.
# COMMS_DML_ROLE=
