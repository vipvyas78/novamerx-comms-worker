{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novamerx-comms-worker",
  "main": "src/worker/index.ts",
  // Pinned, not "latest". A compatibility date is what fixes runtime behaviour; letting it
  // drift means a deploy months from now runs on semantics nothing here was tested against.
  "compatibility_date": "2025-02-04",

  // Deliberately NO nodejs_compat. Everything here runs on web-standard APIs - crypto.subtle
  // rather than node:crypto - so an accidental `node:` import is a build failure under
  // `wrangler deploy --dry-run` instead of a runtime error at the edge. The flag would turn
  // that guard off.

  "vars": {
    // TPS's inbound endpoint. Overridden per environment; this default points nowhere real
    // so a misconfigured deploy fails loudly rather than posting somewhere unexpected.
    "TPS_INBOUND_URL": "https://example.invalid/tps-api/internal/email/inbound"
  },

  // Secrets, NOT vars. In the cloud INBOUND_EMAIL_TOKEN and INBOUND_EMAIL_SIGNING_SECRET are
  // Cloudflare Secrets Store bindings, one pair per environment below (nrm-seed-generator#188);
  // "SECRETS_STORE_ID" is filled in at deploy by scripts/render-wrangler.mjs. Locally they are
  // strings in .dev.vars. Both must match TPS's exactly or every message 401s. See README
  // "Rotating the secrets".

  // The dead-letter spool. Optional at runtime - without it a message TPS cannot accept
  // after three attempts is logged and lost, and the README says so - but configured here
  // because that is the whole durability story.
  "r2_buckets": [
    { "binding": "SPOOL", "bucket_name": "novamerx-comms-spool" }
  ],

  // The replay loop. This IS the retry mechanism: Cloudflare Queues caps a message at
  // 128 KB against a payload of up to 20 MB, so a queue could only ever carry a pointer to
  // an R2 object we had already written - a paid dependency providing a timer. A cron is
  // that timer, free.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "observability": { "enabled": true },

  // One script per cloud environment (nrm-seed-generator#145). `vars` and `r2_buckets` do
  // not inherit in wrangler, so each environment states its own; the cron does. Production
  // keeps the original script name, so the Email Routing rule already pointing at
  // `novamerx-comms-worker` stays valid. The top-level block above is what `wrangler dev`
  // runs locally.
  //
  // Each TPS_INBOUND_URL is TPS behind BuildFlow's origin; that path bypasses Cloudflare
  // Access because this Worker cannot log in — the request is bearer + HMAC signed instead.
  // The spool buckets are created by novamerx-infra/terraform (modules/storage).
  "env": {
    "dev": {
      "name": "novamerx-comms-worker-dev",
      "vars": { "TPS_INBOUND_URL": "https://dev.novamerx.ai/tps-api/internal/email/inbound" },
      "r2_buckets": [{ "binding": "SPOOL", "bucket_name": "novamerx-comms-spool-dev", "jurisdiction": "eu" }],
      "secrets_store_secrets": [
        { "binding": "INBOUND_EMAIL_TOKEN", "store_id": "SECRETS_STORE_ID", "secret_name": "dev__INBOUND_EMAIL_TOKEN" },
        { "binding": "INBOUND_EMAIL_SIGNING_SECRET", "store_id": "SECRETS_STORE_ID", "secret_name": "dev__INBOUND_EMAIL_SIGNING_SECRET" }
      ]
    },
    "staging": {
      "name": "novamerx-comms-worker-staging",
      "vars": { "TPS_INBOUND_URL": "https://staging.novamerx.ai/tps-api/internal/email/inbound" },
      "r2_buckets": [{ "binding": "SPOOL", "bucket_name": "novamerx-comms-spool-staging", "jurisdiction": "eu" }],
      "secrets_store_secrets": [
        { "binding": "INBOUND_EMAIL_TOKEN", "store_id": "SECRETS_STORE_ID", "secret_name": "staging__INBOUND_EMAIL_TOKEN" },
        { "binding": "INBOUND_EMAIL_SIGNING_SECRET", "store_id": "SECRETS_STORE_ID", "secret_name": "staging__INBOUND_EMAIL_SIGNING_SECRET" }
      ]
    },
    "production": {
      "name": "novamerx-comms-worker",
      "vars": { "TPS_INBOUND_URL": "https://app.novamerx.ai/tps-api/internal/email/inbound" },
      "r2_buckets": [{ "binding": "SPOOL", "bucket_name": "novamerx-comms-spool", "jurisdiction": "eu" }],
      "secrets_store_secrets": [
        { "binding": "INBOUND_EMAIL_TOKEN", "store_id": "SECRETS_STORE_ID", "secret_name": "production__INBOUND_EMAIL_TOKEN" },
        { "binding": "INBOUND_EMAIL_SIGNING_SECRET", "store_id": "SECRETS_STORE_ID", "secret_name": "production__INBOUND_EMAIL_SIGNING_SECRET" }
      ]
    }
  }
}
